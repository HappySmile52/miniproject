<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- SQL 문법에 대한 파일 (mapper) -->
<mapper namespace="miniproject.counsel_mapper">

<!-- counsel 상담신청 -->
<insert id="insert_counsel" parameterType="counseldto">
insert into counsel (cidx,cname,cemail,ctel,crent,chouse,cdate,ccontent,cregdate)
values ('0',#{cname},#{cemail},#{ctel},#{crent},#{chouse},#{cdate},#{ccontent},now())
</insert>

</mapper>