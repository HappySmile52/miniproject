<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- SQL 문법에 대한 파일 (mapper) -->
<mapper namespace="miniproject.md_choice_mapper">

<!-- mdchoice (추천 분양 정보) 리스트 데이터 : 최신 4개 -->
<select id="mdchoice_select" resultType="mdchoicedto">
select * from md_choice order by midx desc limit 4
</select>

<!-- mdchoice 게시판 글쓰기 -->
<insert id="mdchoice_insert" parameterType="mdchoicedto">
insert into md_choice (midx,md_title,md_details,md_imgs,md_writer,md_content,md_date)
values ('0',#{md_title},#{md_details},#{md_imgs},#{md_writer},#{md_content},now())
</insert>

<!-- mdchoice 게시판 리스트 출력 -->
<select id="board_list" resultType="mdchoicedto">
select midx, replace(md_title, '&lt;br&gt;', ' ') as md_title, md_writer, md_view,
date_format(md_date, '%Y-%m-%d') as md_date
from md_choice
order by midx desc
</select>

</mapper>