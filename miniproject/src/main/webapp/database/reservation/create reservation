create table reservation(
ridx int unsigned auto_increment comment '자동증가값',
bidx int unsigned not null comment '매물번호',
remail varchar(80) not null comment '예약자 이메일',
rname varchar(30) not null comment '방문자명',
rtel varchar(11) not null comment '연락처',
rdate date not null comment '방문일시',
rtime varchar(5) not null comment '방문시간',
rcount int not null default 1 comment '방문인원',
rregdate timestamp not null default current_timestamp comment '예약일자',
primary key(ridx),
unique (remail, bidx)
);